<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>SPIKEINV008A.PatchSmoke</AssemblyName>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameManagedDir>$(GameDir)\data_sts2_windows_x86_64</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameManagedDir)\sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameManagedDir)\GodotSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManagedDir)\0Harmony.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
