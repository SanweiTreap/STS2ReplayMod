<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic><AssemblyName>PERF001</AssemblyName>
    <GameDir Condition="'$(GameDir)'==''">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</GameDir>
    <Managed>$(GameDir)/data_sts2_windows_x86_64</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Managed)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Managed)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Managed)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="tests/**/*.cs"/><None Remove="tests/**"/>
    <None Update="PERF001.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
