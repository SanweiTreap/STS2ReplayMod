<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SPIKE001A4</AssemblyName>
    <RootNamespace>Spike001A4</RootNamespace>
    <Version>0.1.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameManagedDir>$(GameDir)\data_sts2_windows_x86_64</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameManagedDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameManagedDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManagedDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Steamworks.NET"><HintPath>$(GameManagedDir)\Steamworks.NET.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="SPIKE001A4.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
  </ItemGroup>
  <Target Name="CopyProbeArtifacts" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\artifacts-r2" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\SPIKE001A4.json" DestinationFolder="$(MSBuildProjectDirectory)\artifacts-r2" />
  </Target>
</Project>
