<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SPIKEINV004B</AssemblyName>
    <RootNamespace>SpikeInv004B</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameManagedDir>$(GameDir)\data_sts2_windows_x86_64</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameManagedDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameManagedDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManagedDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="SPIKEINV004B.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyProbeArtifacts" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\artifacts" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\SPIKEINV004B.json"
          DestinationFolder="$(MSBuildProjectDirectory)\artifacts" />
  </Target>
</Project>
